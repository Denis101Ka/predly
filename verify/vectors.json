{
  "about": "Test vectors for the Predly odds engine. Both verify/odds.py and verify/odds.ts must reproduce every yes_cents value here, otherwise CI fails.",
  "formula": {
    "touch": "d = ln(level/cap) / (sigma*sqrt(tau));  p = clamp(2*(1-Phi(d)), 0.03, 0.97)",
    "floor": "d = ln(cap/level) / (sigma*sqrt(tau));  p = clamp(2*Phi(d)-1, 0.03, 0.97)",
    "cents": "yes = clamp(round(p*100), 1, 99);  no = 100 - yes",
    "sigma": "sample std of 5m close-to-close log returns over the last 6h, times sqrt(12), clamped to [0.05, 3]",
    "tau": "hours to the deadline, floored at one minute"
  },
